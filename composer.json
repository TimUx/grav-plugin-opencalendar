{
    "name": "timux/grav-plugin-opencalendar",
    "type": "grav-plugin",
    "description": "OpenCalendar — unified calendar aggregation for Grav CMS with ICS, CalDAV, JSON, and local sources",
    "keywords": ["grav", "grav-plugin", "calendar", "ics", "caldav", "events"],
    "homepage": "https://github.com/TimUx/grav-plugin-opencalendar",
    "license": "MIT",
    "authors": [
        {
            "name": "TimUx",
            "homepage": "https://github.com/TimUx"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "sabre/vobject": "^4.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.11",
        "squizlabs/php_codesniffer": "^3.10",
        "twig/twig": "^3.14"
    },
    "autoload": {
        "psr-4": {
            "Grav\\Plugin\\OpenCalendar\\": "classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Grav\\Plugin\\OpenCalendar\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "phpcs": "phpcs",
        "check": [
            "@phpcs",
            "@phpstan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "archive": {
        "exclude": [
            "/.github",
            "/docs",
            "/tests",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/phpunit.xml",
            "/phpstan.neon",
            "/phpcs.xml",
            "/CONTRIBUTING.md",
            "/CONTRIBUTING.de.md",
            "/CODE_OF_CONDUCT.md",
            "/CODE_OF_CONDUCT.de.md",
            "/SECURITY.md",
            "/SECURITY.de.md",
            "/README.de.md"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
