# Exclude development / GitHub-only paths from release archives
# (GPM install, GitHub Source ZIP, `git archive`, Composer --prefer-dist).
# Runtime plugin files and Grav-required CHANGELOG / LICENSE / README stay included.

/.github/                export-ignore
/docs/                   export-ignore
/tests/                  export-ignore

/.editorconfig           export-ignore
/.gitattributes          export-ignore
/.gitignore              export-ignore

/phpunit.xml             export-ignore
/phpstan.neon            export-ignore
/phpcs.xml               export-ignore

/CONTRIBUTING.md         export-ignore
/CONTRIBUTING.de.md      export-ignore
/CODE_OF_CONDUCT.md      export-ignore
/CODE_OF_CONDUCT.de.md   export-ignore
/SECURITY.md             export-ignore
/SECURITY.de.md          export-ignore
/README.de.md            export-ignore
